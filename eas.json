{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "BETA_MODE": "false"
      }
    },
    "preview": {
      "distribution": "store",
      "env": {
        "BETA_MODE": "true"
      }
    },
    "production": {
      "distribution": "store",
      "env": {
        "BETA_MODE": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
